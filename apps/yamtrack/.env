# ==========================
#    Application Settings
# ==========================
URLS=https://${YAMTRACK_HOSTNAME}
REGISTRATION=True

# ==========================
#        Database Settings
# ==========================
REDIS_URL=redis://yamtrack_redis:6379
# Generate: echo "$(openssl rand -base64 64 | tr -d '=/' | tr -d '\n')"
SECRET=CHANGEME

# ==========================
#       Media Sources
# ==========================
TMDB_API=${TMDB_API_KEY}
TMDB_NSFW=False
TMDB_LANGUAGE=en-US
MAL_NSFW=False
MU_NSFW=False
IGDB_NSFW=False
# IGDB_ID=
# IGDB_SECRET=
# MAL_API=
# TRAKT_ID=
# SIMKL_ID=
# SIMKL_SECRET=

# ==========================
#         General
# ==========================
TZ=${TZ}
PUID=${PUID}
PGID=${PGID}